  },
  {
    "name": "first_seen_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "First observation of this item by this search"
  },
  {
    "name": "is_seed",
    "type": "BOOLEAN",
    "mode": "REQUIRED",
    "description": "True for rows written by a search's silent first run"
  },
  {
    "name": "notified",
    "type": "BOOLEAN",
    "mode": "REQUIRED",
    "description": "False for seed rows and for hits past the max_notify cap"
  },
  {
    "name": "notified_at",
    "type": "TIMESTAMP",
    "mode": "NULLABLE"
  },
  {
