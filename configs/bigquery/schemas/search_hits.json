[
  {
    "name": "run_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "One watch-searches invocation"
  },
  {
    "name": "search_name",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Search name from configs/searches.yaml"
  },
  {
    "name": "item_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "eBay Browse item id (v1|123|0)"
  },
  {
    "name": "cache_key",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Dedup key: search_name + unit separator + item_id"
  },
  {
    "name": "hit_type",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "NEW_LISTING (v1). Extension point for PRICE_DROP / ENDING_SOON"
  },
  {
    "name": "hit_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
