    "type": "STRING",
    "mode": "NULLABLE",
    "description": "ts of the parent message, to jump back to the thread"
  },
  {
    "name": "title",
    "type": "STRING",
    "mode": "NULLABLE"
  },
  {
    "name": "item_web_url",
    "type": "STRING",
    "mode": "NULLABLE"
